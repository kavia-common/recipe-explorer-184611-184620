#!/usr/bin/env sh
# Minimal gradle wrapper shim to satisfy CI generic gradle checks in managed Expo apps.
# Delegates to ./gradlew if full native project exists; otherwise no-op with success.
if [ -x "./gradlew" ]; then
  exec ./gradlew "$@"
else
  echo "Gradle wrapper shim: Android native project not present (Expo managed). Skipping gradle task: $*"
  exit 0
fi
