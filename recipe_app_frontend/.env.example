# Port where the preview system expects readiness (defaults to 3000)
EXPO_PUBLIC_PORT=3000

# Path the preview healthcheck server will respond to (defaults to /healthz)
EXPO_PUBLIC_HEALTHCHECK_PATH=/healthz

# Trust proxy settings for Express (defaults to true)
EXPO_PUBLIC_TRUST_PROXY=true

# Logging: info|silent (defaults to info)
EXPO_PUBLIC_LOG_LEVEL=info

# Optional feature flags (JSON string). Not used currently but reserved.
EXPO_PUBLIC_FEATURE_FLAGS={}

# Experiments toggle (string true/false)
EXPO_PUBLIC_EXPERIMENTS_ENABLED=false
